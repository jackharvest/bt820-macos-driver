#!/bin/sh
# Manage the BT820 print queue (an ippeveprinter instance run as a LaunchAgent).
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
LABEL=com.jackharvest.bt820queue
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SPOOL="$HOME/Library/Caches/bt820-spool"
LOG="$HOME/Library/Logs/bt820-queue.log"
NAME="BT820 Label Printer"
QUEUE=BT820
PORT=8820

write_plist() {
  mkdir -p "$HOME/Library/LaunchAgents" "$SPOOL"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ippeveprinter</string>
    <string>-a</string><string>$ROOT/share/bt820.conf</string>
    <string>-c</string><string>$ROOT/bin/bt820-ippfilter</string>
    <string>-d</string><string>$SPOOL</string>
    <string>-p</string><string>$PORT</string>
    <string>-l</string><string>USB</string>
    <string>$NAME</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
PLIST
}

case "${1:-status}" in
  install|start)
    write_plist
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    # Give ippeveprinter a moment to bind before CUPS queries it.
    sleep 2
    if ! lpstat -p "$QUEUE" >/dev/null 2>&1; then
      # No -m: on macOS 26 every driver/PPD path is gone, and a bare -v on an
      # ipp:// URI is the one remaining way to create a working queue.
      lpadmin -p "$QUEUE" -E -v "ipp://localhost:$PORT/ipp/print" -o printer-is-shared=false
      echo "Created CUPS queue \"$QUEUE\"."
    fi
    echo "Queue running as \"$NAME\" on port $PORT (CUPS queue: $QUEUE)."
    echo "Print with:  lp -d $QUEUE label.pdf      or Cmd+P and pick $QUEUE."
    ;;
  stop)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    echo "Queue stopped (it will not restart at login until you run: bt820ctl start)."
    ;;
  status)
    if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
      echo "queue: RUNNING (\"$NAME\", port $PORT)"
    else
      echo "queue: stopped"
    fi
    "$ROOT/bin/bt820print" --status || true
    ;;
  log)  tail -n "${2:-40}" "$LOG" ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"
    rm -rf "$SPOOL"
    lpadmin -x "$QUEUE" 2>/dev/null && echo "Removed CUPS queue \"$QUEUE\"." || true
    echo "Removed: $PLIST and $SPOOL"
    echo "Still on disk (delete by hand if you want them gone):"
    echo "  $ROOT      -- the project itself"
    echo "  $LOG       -- the queue log"
    echo "Nothing else was touched -- no kexts, no system files, no sudo."
    ;;
  *) echo "usage: bt820ctl {start|stop|status|log [n]|uninstall}" >&2; exit 2 ;;
esac
