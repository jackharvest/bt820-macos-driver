#!/bin/sh
# Manage the BT820 print queue (an ippeveprinter instance run as a LaunchAgent).
#
# Works from either layout: the git repo (bin/ + share/) or a flat install
# such as /usr/local/lib/bt820 created by the .pkg.
set -e
SELF=$(cd "$(dirname "$0")" && pwd)
if [ -f "$SELF/../share/bt820.conf" ]; then
  BIN="$SELF/bt820print"; CONF="$SELF/../share/bt820.conf"
else
  BIN="$SELF/bt820print"; CONF="$SELF/bt820.conf"
fi
FILTER="$SELF/bt820-ippfilter"

LABEL=com.jackharvest.bt820queue
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
STATE="$HOME/Library/Application Support/bt820"
SPOOL="$HOME/Library/Caches/bt820-spool"
LOG="$HOME/Library/Logs/bt820-queue.log"
NAME="BT820 Label Printer"
QUEUE=BT820
IPP2PPD=/System/Library/Printers/Libraries/ipp2ppd
# macOS ships ippeveprinter from CUPS 2.3.4 (2020), which rejects the body iOS
# sends with Create-Job and leaves the phone retrying forever. Prefer a newer
# one if Homebrew's cups is installed.
IPPEVE=/usr/bin/ippeveprinter
for c in /opt/homebrew/opt/cups/bin/ippeveprinter /opt/homebrew/opt/cups/sbin/ippeveprinter \
         /usr/local/opt/cups/bin/ippeveprinter /usr/local/opt/cups/sbin/ippeveprinter; do
  [ -x "$c" ] && IPPEVE="$c"
done
PORT=8820

write_plist() {
  mkdir -p "$HOME/Library/LaunchAgents" "$SPOOL" "$STATE"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$IPPEVE</string>
    <string>-a</string><string>$CONF</string>
    <string>-c</string><string>$FILTER</string>
    <string>-d</string><string>$SPOOL</string>
    <string>-p</string><string>$PORT</string>
    <string>-l</string><string>USB</string>
    <!-- iOS browses the _universal subtype; without it AirPrint never lists us. -->
    <string>-r</string><string>_print,_universal</string>
    <string>$NAME</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
PLIST
}

# A queue made with a bare -v and no driver comes out "raw", and macOS 26 hides
# raw queues from Printers & Scanners entirely. Apple's ipp2ppd turns our own
# IPP attributes into a PPD, which yields a proper driverless AirPrint queue.
# macOS bundles ippeveprinter from CUPS 2.3.4, which rejects the body iOS sends
# with Create-Job, so AirPrint jobs never arrive. 2.4.x fixes it.
airprint_ok() {
  case "$IPPEVE" in /usr/bin/ippeveprinter) return 1 ;; *) return 0 ;; esac
}

airprint_note() {
  if airprint_ok; then
    echo "AirPrint: on -- printing from an iPhone or iPad should work."
  else
    echo
    echo "AirPrint from iPhone/iPad is NOT available yet."
    echo "  macOS ships ippeveprinter from CUPS 2.3.4, which cannot accept jobs"
    echo "  from iOS. Install a newer CUPS and restart the queue:"
    echo
    echo "      brew install cups && bt820ctl start"
    echo
    echo "  Printing from this Mac works either way."
  fi
}

queue_is_raw() {
  lpoptions -p "$QUEUE" 2>/dev/null | grep -q "Local Raw Printer"
}

create_queue() {
  uri="ipp://localhost:$PORT/ipp/print"
  # Location is free text and shows in Printers & Scanners, so use it to say
  # how to turn AirPrint on when this Mac cannot do it yet.
  if airprint_ok; then
    where="USB - AirPrint ready"
  else
    where="USB - for AirPrint: brew install cups"
  fi
  ppd=$(mktemp -t bt820).ppd
  if [ -x "$IPP2PPD" ] && "$IPP2PPD" "$uri" "" >"$ppd" 2>/dev/null && [ -s "$ppd" ]; then
    lpadmin -p "$QUEUE" -E -v "$uri" -P "$ppd" \
      -D "$NAME" -L "$where" 2>&1 | grep -vi deprecated || true
  else
    lpadmin -p "$QUEUE" -E -v "$uri" -D "$NAME" -L "$where"
    echo "Note: no ipp2ppd on this system -- the queue works from the command"
    echo "line but may not show in Printers & Scanners."
  fi
  rm -f "$ppd"
}

case "${1:-status}" in
  install|start)
    write_plist
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    sleep 2   # let ippeveprinter bind before CUPS queries it
    if ! lpstat -p "$QUEUE" >/dev/null 2>&1; then
      create_queue
      echo "Created CUPS queue \"$QUEUE\"."
    elif queue_is_raw; then
      # Left over from an older version, which macOS will not display.
      lpadmin -x "$QUEUE" 2>/dev/null || true
      sleep 1
      create_queue
      echo "Rebuilt \"$QUEUE\" as a driverless queue so it appears in Settings."
    fi
    echo "Queue running as \"$NAME\" on port $PORT (CUPS queue: $QUEUE)."
    echo "Print with:  lp -d $QUEUE label.pdf      or Cmd+P and pick $QUEUE."
    airprint_note
    ;;
  stop)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    echo "Queue stopped (it will not restart at login until: bt820ctl start)."
    ;;
  status)
    if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
      echo "queue: RUNNING (\"$NAME\", port $PORT)"
    else
      echo "queue: stopped"
    fi
    [ -f "$STATE/dryrun" ] && echo "DRY RUN is on (rm \"$STATE/dryrun\" to print for real)"
    echo "server: $IPPEVE"
    airprint_note
    "$BIN" --status || true
    ;;
  dryrun)
    mkdir -p "$STATE"
    case "${2:-on}" in
      on)  touch "$STATE/dryrun"; echo "Dry run ON -- jobs render to $STATE/dryrun-preview.png" ;;
      off) rm -f "$STATE/dryrun"; echo "Dry run OFF -- jobs print for real" ;;
    esac
    ;;
  share)
    case "${2:-show}" in
      on)  lpadmin -p "$QUEUE" -o printer-is-shared=true;  echo "Sharing on." ;;
      off) lpadmin -p "$QUEUE" -o printer-is-shared=false; echo "Sharing off." ;;
      show) lpoptions -p "$QUEUE" 2>/dev/null | tr ' ' '\n' | grep printer-is-shared || true ;;
      *) echo "usage: bt820ctl share {on|off|show}" >&2; exit 2 ;;
    esac ;;
  airprint)
    echo "server: $IPPEVE"
    airprint_note
    if airprint_ok; then
      echo
      echo "Advertised to iOS as \"$NAME\". Check with:"
      echo "  dns-sd -B _ipp._tcp,_universal local"
    fi ;;
  media)
    mkdir -p "$STATE"
    case "${2:-show}" in
      continuous)
        printf 'media=continuous\n' > "$STATE/config"
        echo "Media: continuous -- the printer will not look for gaps."
        echo "Use this when feeding labels one at a time." ;;
      gap)
        printf 'media=gap\n' > "$STATE/config"
        echo "Media: die-cut gap (rolls and fanfold stacks)." ;;
      show)
        if [ -f "$STATE/config" ]; then cat "$STATE/config"; else echo "media=gap (default)"; fi ;;
      *) echo "usage: bt820ctl media {continuous|gap|show}" >&2; exit 2 ;;
    esac ;;
  log)  tail -n "${2:-40}" "$LOG" ;;
  uninstall)
    # Another copy may still be installed (Homebrew alongside the .pkg, say).
    # The queue, LaunchAgent and settings are shared, so tearing them down
    # would break the copy that remains.
    other=""
    for cand in /opt/homebrew/bin/bt820ctl /usr/local/bin/bt820ctl; do
      [ -x "$cand" ] || continue
      [ "$(cd "$(dirname "$cand")" && pwd)" = "$SELF" ] && continue
      other="$cand"
    done
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"; rm -rf "$SPOOL"
    lpadmin -x "$QUEUE" 2>/dev/null && echo "Removed CUPS queue \"$QUEUE\"." || true
    echo "Removed: $PLIST, $SPOOL"
    if [ -n "$other" ]; then
      echo
      echo "Kept your settings ($STATE) -- another install is still present:"
      echo "  $other"
      echo "Bring its queue back with:  $other start"
    else
      rm -rf "$STATE"
      echo "Removed: $STATE"
    fi
    echo "Left alone: $LOG, and the program files themselves."
    echo "No kexts, no system files, no sudo were ever involved."
    ;;
  *) echo "usage: bt820ctl {start|stop|status|airprint|media continuous|gap|share on|off|dryrun on|off|log [n]|uninstall}" >&2; exit 2 ;;
esac
